# Save as /etc/systemd/system/audio-manager-geocode-locations.timer
# Names are normally looked up as soon as a location appears or moves; this catches anything left queued while
# the Photon geocoder was down (the queue is just "locations with no place_checked_at").

[Unit]
Description=Run audio-manager geocode-locations every 15 minutes

[Timer]
OnBootSec=4min
OnUnitActiveSec=15min
Persistent=true

[Install]
WantedBy=timers.target
