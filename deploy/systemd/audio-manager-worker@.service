# Save as /etc/systemd/system/audio-manager-worker@.service (a
# TEMPLATE unit - note the @ before .service).
#
# This is the queue consumer — a long-running daemon, NOT a
# timer-triggered oneshot like the other units in this directory.
# Safe to run multiple instances: claiming uses Postgres's
# FOR UPDATE SKIP LOCKED (jobs/queue.py), so two instances can never
# claim the same job_queue row. The %i instance name is just for
# systemd bookkeeping/logging (`journalctl -u audio-manager-worker@1`)
# — worker.py itself doesn't need to know its instance number, it
# identifies itself internally as "<hostname>:<pid>".
#
# Enable ONE worker (the common case for this app's volume):
#   systemctl daemon-reload
#   systemctl enable --now audio-manager-worker@1.service
#
# Enable a second, e.g. after a backlog builds up or you add more
# concurrent external-facing jobs:
#   systemctl enable --now audio-manager-worker@2.service
#
# Each instance is independent - stopping/restarting one doesn't
# affect the other, and you can scale up or down without touching any
# other unit in this directory.

[Unit]
Description=Audio Manager job queue worker (instance %i)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/audio-manager
EnvironmentFile=/etc/audio-manager/audio-manager.env
# Run as a module, never as `python3 jobs/worker.py`: a script path puts
# jobs/ first on sys.path, so jobs/queue.py shadows the stdlib `queue`
# module and requests/urllib3 fail to import (DEPLOYMENT.md).
ExecStart=/opt/audio-manager/.venv/bin/python3 -m jobs.worker
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
